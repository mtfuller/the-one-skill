{
  "policy_version": "1.1.0",
  "allowed_script_languages": [
    "python3-stdlib"
  ],
  "require_trusted_source": true,
  "trusted_sources_config": "config/trusted-sources.json",
  "banned_patterns": [
    {
      "id": "SEC-001",
      "category": "prompt_injection_override",
      "severity": "critical",
      "description": "Attempts to override system instructions, safety gates, or explicit consent markers.",
      "regex": "(?i)(ignore\\s+(all\\s+)?(previous|prior|system)\\s+instructions|disregard\\s+safety|bypass\\s+security\\s+policy|skip\\s+diff\\s+approval)"
    },
    {
      "id": "SEC-002",
      "category": "network_exfiltration",
      "severity": "critical",
      "description": "Outbound network requests or webhook exfiltration commands inside skills or scripts.",
      "regex": "(?i)(curl\\s+-[a-zA-Z]*d|wget\\s+--post|urllib\\.request\\.urlopen|requests\\.(post|put)|webhook\\.site|ngrok-free\\.app|pipedream\\.net|burpcollaborator)"
    },
    {
      "id": "SEC-003",
      "category": "credential_harvesting",
      "severity": "critical",
      "description": "Reads sensitive host credentials, SSH keys, cloud tokens, or environment secrets.",
      "regex": "(?i)(~/.ssh/id_|~/.aws/credentials|~/.config/gcloud|OPENAI_API_KEY|ANTHROPIC_API_KEY|GEMINI_API_KEY|GITHUB_TOKEN|os\\.environ)"
    },
    {
      "id": "SEC-004",
      "category": "opaque_execution",
      "severity": "high",
      "description": "Obfuscated payloads or dynamic code execution in skill markdown or scripts.",
      "regex": "(?i)(base64\\.b64decode\\s*\\(|exec\\s*\\(\\s*compile|eval\\s*\\(\\s*__import__|subprocess\\.(Popen|run|call)\\s*\\(.*shell\\s*=\\s*True)"
    },
    {
      "id": "SEC-005",
      "category": "unauthorized_mutation",
      "severity": "high",
      "description": "Attempts to remove or tamper with the-one-skill:ignore markers without user request.",
      "regex": "(?i)(remove\\s+the-one-skill:ignore|strip\\s+ignore\\s+marker\\s+silently)"
    }
  ]
}
